NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:passwd@localhost:5432/main_db

REDIS_URL=redis://:SECURE_REDIS_PASSWORD_FROM_VAULT@prod-redis.example.com:6379

JWT_ACCESS_SECRET=DEVELOPMENT_ACCESS_SECRET
JWT_REFRESH_SECRET=DEVELOPMENT_REFRESH_SECRET
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

SMTP_HOST=prod-smtp.example.com
SMTP_PORT=587
SMTP_USER=development-email@example.com
SMTP_PASSWORD=SECURE_SMTP_PASSWORD
MAIL_FROM=noreply@example.com

AWS_REGION=us-east-1
AWS_S3_BUCKET=my-app-development-bucket

OPENAI_API_KEY=sk-prod-key
GOOGLE_API_KEY=prod-google-key

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

API_URL=https://api.example.com
FRONTEND_URL=https://example.com