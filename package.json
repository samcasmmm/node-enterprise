{
  "name": "erp-system",
  "version": "0.0.1",
  "description": "Enterprise Resource Planning (ERP) System Backend",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Sameer Bagwan",
  "keywords": [
    "express",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/[username]/[repo_name].git"
  },
  "homepage": "https://github.com/[username]/[repo_name]#readme",
  "bugs": {
    "url": "https://github.com/[username]/[repo_name]/issues"
  },
  "scripts": {
    "clean": "rimraf public/dist",
    "build": "tsc -p tsconfig.json",
    "build:dev": "cross-env NODE_ENV=development npm run build",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node public/dist/index.js",
    "start:dev": "cross-env NODE_ENV=development npm run start",
    "start:prod": "cross-env NODE_ENV=production npm run start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seed/index.ts",
    "make": "node scripts/create-module.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "check": "prettier . --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.9.19",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.23",
    "chalk": "^5.6.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "inquirer": "^13.2.5",
    "jsonwebtoken": "^9.0.3",
    "juice": "^11.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.18.0",
    "postgres": "^3.4.4",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "tsyringe": "^4.8.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^3.4.1",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.10",
    "tsc-alias": "^1.8.16",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
